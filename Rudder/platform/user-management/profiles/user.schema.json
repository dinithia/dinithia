{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rudder.local/schemas/platform/user.json",
  "title": "User",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "email", "status", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^usr_[A-Z0-9]+$"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "email_verified": {
      "type": "boolean",
      "default": false
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "avatar_url": {
      "type": "string",
      "format": "uri"
    },
    "status": {
      "type": "string",
      "enum": ["invited", "active", "suspended", "deactivated", "deleted"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_login_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}
