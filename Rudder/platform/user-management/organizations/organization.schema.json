{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rudder.local/schemas/platform/organization.json",
  "title": "Organization",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "slug", "status", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^org_[A-Z0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 63
    },
    "status": {
      "type": "string",
      "enum": ["active", "suspended", "deleted"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
