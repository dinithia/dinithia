{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rudder.local/schemas/platform/permission.json",
  "title": "Permission",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "action", "resource_type", "description"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$",
      "description": "Canonical permission id as resource_type:action"
    },
    "action": {
      "type": "string",
      "enum": ["create", "read", "write", "delete", "manage", "assign", "invite"]
    },
    "resource_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  }
}
