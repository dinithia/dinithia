{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rudder.local/schemas/platform/role.json",
  "title": "Role",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "permissions"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "system": {
      "type": "boolean",
      "default": false,
      "description": "Built-in role that cannot be deleted"
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
      }
    }
  }
}
